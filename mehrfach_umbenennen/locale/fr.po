msgstr "Nouveau nom de fichier"

msgid "New name"
msgstr "Nouveau nom"

msgid "Note"
msgstr "Remarque"

msgid "Old name"
msgstr "Ancien nom"

msgid "Open"
msgstr "Ouvrir"

