msgstr "Impossible de défaire."

msgid "[C] Counter"
msgstr "[C] Compteur"

msgid "[E#-#] Part"
msgstr "[E#-#] Partie"

msgid "[E] Extension"
msgstr "[E] Extension"

msgid "[N#-#] Part"
msgstr "[N#-#] Partie"

msgid "[N] Name"
msgstr "[N] Nom"

msgid "[P] Folder"
msgstr "[P] Dossier"

msgid "[YMD] Date"
msgstr "[YMD] Date"

msgid "[hms] Time"
msgstr "[hms] Heure"

msgid "also in extension"
msgstr "aussi dans l’extension"

msgid "by date"
msgstr "par date"

msgid "by name"
msgstr "par nom"

msgid "count from the end (the last characters)"
msgstr "compter depuis la fin (les derniers caractères)"

msgid "lowercase"
msgstr "minuscules"

msgid "only once"
msgstr "une seule fois"

msgid "or drag rows with the mouse"
msgstr "ou déplacez les lignes avec la souris"

msgid "unchanged"
msgstr "inchangé"

msgid "up to the end (even if other names are longer)"
msgstr "jusqu’à la fin (même si d’autres noms sont plus longs)"
